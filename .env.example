# SQLite database file
DATABASE_URL=file:local.db

# TMDB credentials: either the v3 "API Key" or the v4 "API Read Access Token".
# Free: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Country used for "where to watch" (ISO 3166-1, e.g. NL, BE, US, GB)
TMDB_REGION=NL
# Language for titles/overviews (e.g. en-US, nl-NL)
TMDB_LANGUAGE=en-US

# Production public URL (required behind Coolify's proxy)
# ORIGIN=https://seenornot.apps.gertjanassies.dev
# Only behind a trusted single proxy; see README before enabling
# ADDRESS_HEADER=x-forwarded-for
# XFF_DEPTH=1
